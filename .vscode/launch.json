{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["server.main:app", "--port", "8000"],
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "Client HUD",
      "type": "debugpy",
      "request": "launch",
      "module": "client.main",
      "envFile": "${workspaceFolder}/.env"
    }
  ],
  "compounds": [
    { "name": "Server + Client", "configurations": ["Server", "Client HUD"] }
  ]
}
