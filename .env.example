OPENAI_API_KEY=sk-your-key-here
REALTIME_MODEL=gpt-realtime-2.1
TRANSCRIBE_MODEL=gpt-4o-transcribe
VAD_START=0.5
VAD_END=0.35
VAD_SILENCE_MS=350
MIN_TURN_MS=600
BARGE_IN=true

SERVER_URL=ws://127.0.0.1:8000/ws
AUDIO_DEVICE=
MONITOR=1
SCREEN_HZ=2
DELTA_THRESHOLD=0.015
MIN_FRAME_INTERVAL=1.0
JPEG_QUALITY=75
HIDE_FROM_CAPTURE=true
